#Область ОбработчикиСобытий

// Регистрирует документ на узлах плана обмена, соответствующих ответственному.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи.
Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Ответственный) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Узлы.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.ОбменСМобильнымПриложением КАК Узлы
		|ГДЕ
		|	Узлы.Пользователь = &Пользователь
		|	И НЕ Узлы.ЭтотУзел";
	Запрос.УстановитьПараметр("Пользователь", Ответственный);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Узлы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Узлы.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если Узлы.Количество() > 0 Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(Узлы, Ссылка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
