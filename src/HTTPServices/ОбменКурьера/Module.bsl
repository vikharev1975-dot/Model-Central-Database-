#Область ОбработчикиСобытий

// Обрабатывает запрос обмена данными с мобильным устройством.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - HTTP-запрос.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ с данными зарегистрированных документов.
Функция exchange(Запрос)
	
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		Данные = ОбменСМобильнымПриложением.ПрочитатьJSONИзСтроки(ТелоЗапроса);
		
		Если ТипЗнч(Данные) <> Тип("Структура") Тогда
			ВызватьИсключение "Некорректный формат запроса";
		КонецЕсли;
		
		ИдентификаторУстройства = Данные.Получить("deviceId");
		Если ПустаяСтрока(ИдентификаторУстройства) Тогда
			ВызватьИсключение "Не передан идентификатор устройства";
		КонецЕсли;
		
		ИмяПользователя = ОбменСМобильнымПриложением.ИмяСотрудника();
		Узел = ОбменСМобильнымПриложением.ИнициализироватьУзел(ИдентификаторУстройства, ИмяПользователя);
		
		ОбменСМобильнымПриложением.ПрименитьДанныеСУстройства(Узел, Данные);
		
		Результат = ОбменСМобильнымПриложением.ПолучитьДанныеУзла(Узел);
		ОбменСМобильнымПриложением.СнятьРегистрацию(Узел);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.УстановитьТелоИзСтроки(ОбменСМобильнымПриложением.СериализоватьВJSON(Результат), "UTF-8");
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ошибка = Новый Структура("error", ОписаниеОшибки());
		Ответ.УстановитьТелоИзСтроки(ОбменСМобильнымПриложением.СериализоватьВJSON(Ошибка), "UTF-8");
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Принимает фотографию документа "Доставка" от мобильного устройства.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - HTTP-запрос.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - результат приёма фотографии.
Функция uploadPhoto(Запрос)
	
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		Данные = ОбменСМобильнымПриложением.ПрочитатьJSONИзСтроки(ТелоЗапроса);
		
		Если ТипЗнч(Данные) <> Тип("Структура") Тогда
			ВызватьИсключение "Некорректный формат запроса";
		КонецЕсли;
		
		ИдентификаторУстройства = Данные.Получить("deviceId");
		ИдентификаторДокумента = Данные.Получить("documentUuid");
		ФотоБазе64 = Данные.Получить("photoBase64");
		
		ИмяПользователя = ОбменСМобильнымПриложением.ИмяСотрудника();
		Узел = ОбменСМобильнымПриложением.ИнициализироватьУзел(ИдентификаторУстройства, ИмяПользователя);
		
		ОбменСМобильнымПриложением.ПринятьФото(Узел, ИдентификаторДокумента, ФотоБазе64);
		
		Результат = Новый Структура("ok", Истина);
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.УстановитьТелоИзСтроки(ОбменСМобильнымПриложением.СериализоватьВJSON(Результат), "UTF-8");
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ошибка = Новый Структура("error", ОписаниеОшибки());
		Ответ.УстановитьТелоИзСтроки(ОбменСМобильнымПриложением.СериализоватьВJSON(Ошибка), "UTF-8");
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти
