// Возвращает сотрудника, соответствующего текущему пользователю информационной базы.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - найденный сотрудник или пустая ссылка.
Функция ТекущийСотрудник() Экспорт
	
	ИмяПользователяИБ = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Возврат Справочники.Пользователи.НайтиПоРеквизиту("ИмяПользователяИБ", ИмяПользователяИБ);
	
КонецФункции

// Возвращает наименование сотрудника для текущего пользователя информационной базы.
//
// Возвращаемое значение:
//  Строка - наименование сотрудника или имя пользователя ИБ, если сотрудник не найден.
Функция ИмяСотрудника() Экспорт
	
	ИмяПользователяИБ = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.ИмяПользователяИБ = &ИмяПользователяИБ";
	Запрос.УстановитьПараметр("ИмяПользователяИБ", ИмяПользователяИБ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Наименование;
	КонецЕсли;
	
	Возврат ИмяПользователяИБ;
	
КонецФункции

// Находит узел плана обмена по идентификатору устройства или создаёт его
// и выполняет первичную регистрацию доставок сотрудника.
//
// Параметры:
//  ИдентификаторУстройства - Строка - уникальный идентификатор устройства.
//  ИмяПользователя - Строка - наименование сотрудника-курьера.
//
// Возвращаемое значение:
//  ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
Функция ИнициализироватьУзел(ИдентификаторУстройства, ИмяПользователя) Экспорт
	
	Узел = ПланыОбмена.ОбменСМобильнымПриложением.НайтиПоКоду(ИдентификаторУстройства);
	Если Не Узел.Пустая() Тогда
		Возврат Узел;
	КонецЕсли;
	
	ОбъектУзла = ПланыОбмена.ОбменСМобильнымПриложением.СоздатьУзел();
	ОбъектУзла.Код = ИдентификаторУстройства;
	ОбъектУзла.Наименование = ИмяПользователя;
	ОбъектУзла.Пользователь = ИмяПользователя;
	ОбъектУзла.Записать();
	
	Узел = ОбъектУзла.Ссылка;
	ЗарегистрироватьНачальныеДанные(Узел, ИмяПользователя);
	
	Возврат Узел;
	
КонецФункции

// Формирует данные зарегистрированных на узле документов "Доставка".
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
//
// Возвращаемое значение:
//  Структура - данные узла:
//   * nodeCode - Строка - код узла;
//   * employee - Строка - сотрудник;
//   * documents - Массив из Структура - документы.
Функция ПолучитьДанныеУзла(Узел) Экспорт
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Узлы.Код КАК Код,
		|	Узлы.Пользователь КАК Пользователь
		|ИЗ
		|	ПланОбмена.ОбменСМобильнымПриложением КАК Узлы
		|ГДЕ
		|	Узлы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Узел);
	
	ВыборкаУзла = Запрос.Выполнить().Выбрать();
	Если ВыборкаУзла.Следующий() Тогда
		Результат.Вставить("nodeCode", Строка(ВыборкаУзла.Код));
		Результат.Вставить("employee", Строка(ВыборкаУзла.Пользователь));
	Иначе
		Результат.Вставить("nodeCode", "");
		Результат.Вставить("employee", "");
	КонецЕсли;
	
	МассивДокументов = Новый Массив;
	НомерСообщения = 1;
	
	Выборка = ПланыОбмена.ВыбратьИзменения(Узел, НомерСообщения, Метаданные.Документы.Доставка);
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Получить();
		Если ТипЗнч(Объект) = Тип("ДокументСсылка.Доставка") Тогда
			Объект = Объект.Получить();
		КонецЕсли;
		
		Если ТипЗнч(Объект) = Тип("ДокументОбъект.Доставка") Тогда
			МассивДокументов.Добавить(Объект);
		КонецЕсли;
		
	КонецЦикла;
	
	ТелефоныКонтрагентов = ТелефоныКонтрагентов(МассивДокументов);
	
	ДокументыКОбмену = Новый Массив;
	Для Каждого Документ Из МассивДокументов Цикл
		ДокументыКОбмену.Добавить(ДанныеДокумента(Документ, ТелефоныКонтрагентов));
	КонецЦикла;
	
	Результат.Вставить("documents", ДокументыКОбмену);
	
	Возврат Результат;
	
КонецФункции

// Применяет изменения статуса и комментария, полученные с мобильного устройства.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
//  Данные - Структура - разобранный JSON запроса.
Процедура ПрименитьДанныеСУстройства(Узел, Данные) Экспорт
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыИзЗапроса = Данные["documents"];
	Если ТипЗнч(ДокументыИзЗапроса) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеДокумента Из ДокументыИзЗапроса Цикл
		
		Если ТипЗнч(ДанныеДокумента) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Идентификатор = ДанныеДокумента["uuid"];
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		
		Ссылка = Документы.Доставка.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Если Ссылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		Объект = Ссылка.Получить();
		Объект.ОбменДанными.Загрузка = Истина;
		
		Статус = СтатусПоСтроке(ДанныеДокумента["status"]);
		Если Статус <> Неопределено Тогда
			Объект.Статус = Статус;
		КонецЕсли;
		
		Комментарий = ДанныеДокумента["comment"];
		Если Комментарий <> Неопределено Тогда
			Объект.Комментарий = Строка(Комментарий);
		КонецЕсли;
		
		Объект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Записывает фото, полученное с мобильного устройства, в документ "Доставка".
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
//  ИдентификаторДокумента - Строка - UUID документа.
//  ФотоБазе64 - Строка - изображение в формате Base64.
Процедура ПринятьФото(Узел, ИдентификаторДокумента, ФотоБазе64) Экспорт
	
	Если ПустаяСтрока(ИдентификаторДокумента) Или ПустаяСтрока(ФотоБазе64) Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Документы.Доставка.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторДокумента));
	Если Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзBase64Строки(ФотоБазе64);
	
	Объект = Ссылка.Получить();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Фото = Новый ХранилищеЗначения(ДвоичныеДанные);
	Объект.Записать();
	
КонецПроцедуры

