// Регистрирует доставки сотрудника на узле при первом обращении устройства.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
//  ИмяПользователя - Строка - наименование сотрудника.
Процедура ЗарегистрироватьНачальныеДанные(Узел, ИмяПользователя)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Доставки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Доставка КАК Доставки
		|ГДЕ
		|	Доставки.Ответственный = &Ответственный";
	Запрос.УстановитьПараметр("Ответственный", ИмяПользователя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивСсылок = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если МассивСсылок.Количество() > 0 Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, МассивСсылок);
	КонецЕсли;
	
КонецПроцедуры

// Формирует структуру данных документа для передачи в мобильное приложение.
//
// Параметры:
//  Документ - ДокументОбъект.Доставка - документ.
//  ТелефоныКонтрагентов - Соответствие - телефоны контрагентов:
//   * Ключ - СправочникСсылка.Контрагенты - контрагент;
//   * Значение - Строка - телефон.
//
// Возвращаемое значение:
//  Структура - данные документа.
Функция ДанныеДокумента(Документ, ТелефоныКонтрагентов)
	
	Данные = Новый Структура;
	Данные.Вставить("uuid", Строка(Документ.УникальныйИдентификатор()));
	Данные.Вставить("number", Строка(Документ.Номер));
	Данные.Вставить("date", XMLСтрока(Документ.Дата));
	Данные.Вставить("address", Строка(Документ.АдресДоставки));
	Данные.Вставить("comment", Строка(Документ.Комментарий));
	Данные.Вставить("status", СтатусВСтроку(Документ.Статус));
	Данные.Вставить("responsible", Строка(Документ.Ответственный));
	Данные.Вставить("hasPhoto", ЗначениеЗаполнено(Документ.Фото));
	
	Контрагент = Новый Структура;
	Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
		Телефон = ТелефоныКонтрагентов[Документ.Контрагент];
		Если Телефон = Неопределено Тогда
			Телефон = "";
		КонецЕсли;
		Контрагент.Вставить("uuid", Строка(Документ.Контрагент.УникальныйИдентификатор()));
		Контрагент.Вставить("name", Строка(Документ.Контрагент));
		Контрагент.Вставить("phone", Телефон);
	Иначе
		Контрагент.Вставить("uuid", "");
		Контрагент.Вставить("name", "");
		Контрагент.Вставить("phone", "");
	КонецЕсли;
	Данные.Вставить("counterparty", Контрагент);
	
	Товары = Новый Массив;
	Для Каждого СтрокаТоваров Из Документ.Товары Цикл
		Строка = Новый Структура;
		Строка.Вставить("nomenclatureUuid", Строка(СтрокаТоваров.Номенклатура.УникальныйИдентификатор()));
		Строка.Вставить("nomenclature", Строка(СтрокаТоваров.Номенклатура));
		Строка.Вставить("quantity", СтрокаТоваров.Количество);
		Товары.Добавить(Строка);
	КонецЦикла;
	Данные.Вставить("goods", Товары);
	
	Возврат Данные;
	
КонецФункции

// Загружает телефоны контрагентов одним запросом.
//
// Параметры:
//  МассивДокументов - Массив из ДокументОбъект.Доставка - документы.
//
// Возвращаемое значение:
//  Соответствие - телефоны контрагентов:
//   * Ключ - СправочникСсылка.Контрагенты - контрагент;
//   * Значение - Строка - телефон.
Функция ТелефоныКонтрагентов(МассивДокументов)
	
	СписокКонтрагентов = Новый Массив;
	Для Каждого Документ Из МассивДокументов Цикл
		Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
			СписокКонтрагентов.Добавить(Документ.Контрагент);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Соответствие;
	Если СписокКонтрагентов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Телефон КАК Телефон
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В (&Список)";
	Запрос.УстановитьПараметр("Список", СписокКонтрагентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.Телефон);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое имя статуса доставки.
//
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыДоставок - статус.
//
// Возвращаемое значение:
//  Строка - имя статуса.
Функция СтатусВСтроку(Статус)
	
	Если Статус = Перечисления.СтатусыДоставок.Запланирована Тогда
		Возврат "Запланирована";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.ВзятаВРаботу Тогда
		Возврат "ВзятаВРаботу";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.ОтклоненаКурьером Тогда
		Возврат "ОтклоненаКурьером";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.ОтклоненаКлиентом Тогда
		Возврат "ОтклоненаКлиентом";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.Выполнена Тогда
		Возврат "Выполнена";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает статус доставки по строковому имени.
//
// Параметры:
//  ИмяСтатуса - Строка - имя статуса.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыДоставок, Неопределено - статус.
Функция СтатусПоСтроке(ИмяСтатуса)
	
	Если ИмяСтатуса = "Запланирована" Тогда
		Возврат Перечисления.СтатусыДоставок.Запланирована;
	ИначеЕсли ИмяСтатуса = "ВзятаВРаботу" Тогда
		Возврат Перечисления.СтатусыДоставок.ВзятаВРаботу;
	ИначеЕсли ИмяСтатуса = "ОтклоненаКурьером" Тогда
		Возврат Перечисления.СтатусыДоставок.ОтклоненаКурьером;
	ИначеЕсли ИмяСтатуса = "ОтклоненаКлиентом" Тогда
		Возврат Перечисления.СтатусыДоставок.ОтклоненаКлиентом;
	ИначеЕсли ИмяСтатуса = "Выполнена" Тогда
		Возврат Перечисления.СтатусыДоставок.Выполнена;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

